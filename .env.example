# =====================================================================
# Modo online de ESQUIVA SORETES (Supabase). Ver docs/ONLINE.md.
#
# 1. Copiá este archivo como .env.local (ese archivo NO se sube a GitHub).
# 2. Completá con los datos de TU proyecto: Supabase → Project Settings →
#    API Keys (o Data API para la URL).
# 3. Reiniciá `npm run dev`.
#
# Sin estas variables el juego funciona en MODO LOCAL, como siempre.
# =====================================================================

# URL del proyecto. Ejemplo: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Clave PUBLICABLE (empieza con sb_publishable_). En proyectos viejos también
# sirve la "anon public". Es pública a propósito: la seguridad la ponen las
# reglas de la base (Row Level Security) y las funciones del servidor.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ¡NUNCA pongas acá la clave secreta (sb_secret_...) ni la "service_role"!
# Todo lo que empieza con VITE_ queda dentro del juego publicado y cualquiera
# lo puede leer. Si la ponés por error, el juego la detecta y no la usa.
