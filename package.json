{
  "name": "esquiva-soretes",
  "private": true,
  "version": "0.3.0",
  "description": "ESQUIVA SORETES: una aventura de mierda por Buenos Aires. Arcade 2.5D hecho con Phaser 3 + TypeScript + Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs run",
    "test:watch": "node scripts/test.mjs",
    "online:rules": "node scripts/online-rules.mjs",
    "dev:sandbox": "vite --mode sandbox --port 5174",
    "online:sandbox": "node scripts/online-sandbox/server.mjs",
    "sprites": "node scripts/sprites/convert-sheet.mjs",
    "logo": "node scripts/sprites/convert-logo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
