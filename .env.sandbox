# Modo "sandbox": el juego usa el servidor online de PRUEBA local
# (`npm run online:sandbox`). Se usa con `npm run dev:sandbox`.
# No son datos secretos: el servidor de prueba acepta cualquier clave.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sandbox_local
